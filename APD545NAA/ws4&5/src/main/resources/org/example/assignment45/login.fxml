<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="270.0" prefWidth="649.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.assignment45.Controller.Login">

    <children>
        <VBox alignment="CENTER" layoutX="100.0" layoutY="75.0" spacing="10.0">
            <Label style="-fx-font-size: 24px;" text="Inventory Management System" />
            <TextField fx:id="usernameField" promptText="Username" />
            <PasswordField fx:id="passwordField" promptText="Password" />
            <HBox alignment="CENTER" spacing="10">
                <Button onAction="#handleLogin" text="Login" />
                <Button onAction="#handleCancel" text="Cancel" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>
