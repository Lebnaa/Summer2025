<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seneca.example.ws45.Controller.MainPage">
    <top>
        <Label text="Inventory Management System" style="-fx-font-size: 24px;" BorderPane.alignment="CENTER"/>
    </top>
    <center>
        <HBox alignment="CENTER" spacing="20" BorderPane.alignment="CENTER">

            <!-- Parts Section -->
            <VBox spacing="10">
                <Label text="Parts"/>
                <HBox spacing="5">
                    <TextField fx:id="partSearchField" promptText="Search by Part ID or Name"/>
                    <Button text="Search" onAction="#onSearchPart"/>
                </HBox>
                <TableView fx:id="partTable" prefHeight="250" prefWidth="350">
                    <columns>
                        <TableColumn fx:id="partIdCol" text="Part ID" prefWidth="75"/>
                        <TableColumn fx:id="partNameCol" text="Name" prefWidth="100"/>
                        <TableColumn fx:id="partInvCol" text="Inventory" prefWidth="75"/>
                        <TableColumn fx:id="partPriceCol" text="Price" prefWidth="100"/>
                    </columns>
                </TableView>
                <HBox spacing="5">
                    <Button text="Add" onAction="#onAddPart"/>
                    <Button text="Modify" onAction="#onModifyPart"/>
                    <Button text="Delete" onAction="#onDeletePart"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="btnSaveToFile" text="Save Data To File" onAction="#handleSaveToFile"/>
                    <Button fx:id="btnLoadFromFile" text="Load Data from File" onAction="#handleLoadFromFile"/>
                    <Button fx:id="btnSaveToDB" text="Write Data on DB" onAction="#handleSaveToDB"/>
                    <Button fx:id="btnLoadFromDB" text="Load Data from DB" onAction="#handleLoadFromDB"/>
                </HBox>

            </VBox>

            <!-- Products Section -->
            <VBox spacing="10">
                <Label text="Products"/>
                <HBox spacing="5">
                    <TextField fx:id="productSearchField" promptText="Search by Product ID or Name"/>
                    <Button text="Search" onAction="#onSearchProduct"/>
                </HBox>
                <TableView fx:id="productTable" prefHeight="250" prefWidth="350">
                    <columns>
                        <TableColumn fx:id="productIdCol" text="Product ID" prefWidth="75"/>
                        <TableColumn fx:id="productNameCol" text="Name" prefWidth="100"/>
                        <TableColumn fx:id="productInvCol" text="Inventory" prefWidth="75"/>
                        <TableColumn fx:id="productPriceCol" text="Price" prefWidth="100"/>
                    </columns>
                </TableView>
                <HBox spacing="5">
                    <Button text="Add" onAction="#onAddProduct"/>
                    <Button text="Modify" onAction="#onModifyProduct"/>
                    <Button text="Delete" onAction="#onDeleteProduct"/>
                </HBox>
                <Button text="Exit" onAction="#onExitApplication"/>
            
    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="saveToFileBtn" text="Save Data To File" onAction="#handleSaveToFile"/>
        <Button fx:id="loadFromFileBtn" text="Load Data from File" onAction="#handleLoadFromFile"/>
        <Button fx:id="saveToDBBtn" text="Write Data on DB" onAction="#handleSaveToDB"/>
        <Button fx:id="loadFromDBBtn" text="Load Data from DB" onAction="#handleLoadFromDB"/>
    </HBox>

</VBox>
        </HBox>
    </center>
</BorderPane>
