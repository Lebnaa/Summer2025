<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="736.0" prefWidth="808.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seneca.example.ws45.Controller.AddProduct">

    <children>
        <VBox layoutX="101.0" layoutY="52.0" prefHeight="662.0" prefWidth="275.0" spacing="10">

            <!-- ID -->
            <Label text="ID" />
            <TextField fx:id="idField" editable="false" promptText="Auto Gen - Disabled" />

            <!-- Name -->
            <Label text="Name" />
            <TextField fx:id="nameField" />

            <!-- Inventory -->
            <Label text="Inventory" />
            <TextField fx:id="stockField" />

            <!-- Price -->
            <Label text="Price" />
            <TextField fx:id="priceField" />

            <!-- Max -->
            <Label text="Max" />
            <TextField fx:id="maxField" prefHeight="26.0" prefWidth="264.0" />

            <!-- Min -->
            <Label text="Min" />
            <TextField fx:id="minField" />

            <!-- Search Part -->
            <HBox spacing="10">
                <TextField fx:id="searchPartField" promptText="Search Part" />
                <Button onAction="#onSearchPart" text="Search" />
            </HBox>

            <!-- Available Parts Table -->
            <Label text="Available Parts" />
            <TableView fx:id="allPartsTable" prefHeight="200" prefWidth="400">
                <columns>
                    <TableColumn fx:id="allPartsIdColumn" text="ID" />
                    <TableColumn fx:id="allPartsNameColumn" text="Name" />
                    <TableColumn fx:id="allPartsPriceColumn" text="Price" />
                    <TableColumn fx:id="allPartsStockColumn" text="Stock" />
                </columns>
            </TableView>

            <Button onAction="#onAddPart" text="Add Part" />

            <!-- Save / Cancel -->
            <HBox alignment="CENTER_RIGHT" spacing="10" />
        </VBox>

        <!-- Title -->
        <Label layoutX="232.0" layoutY="8.0" style="-fx-font-size: 20px;" text="Add Product" />

        <!-- Associated Parts Table -->
        <Label layoutX="462.0" layoutY="474.0" text="Associated Parts" />
        <TableView fx:id="associatedPartsTable" layoutX="462.0" layoutY="503.0" prefHeight="168.0" prefWidth="263.0">
            <columns>
                <TableColumn fx:id="associatedPartsIdColumn" text="ID" />
                <TableColumn fx:id="associatedPartsNameColumn" text="Name" />
                <TableColumn fx:id="associatedPartsPriceColumn" text="Price" />
                <TableColumn fx:id="associatedPartsStockColumn" text="Stock" />
            </columns>
        </TableView>

        <Button layoutX="462.0" layoutY="685.0" onAction="#onRemoveAssociatedPart" text="Remove Associated Part" />
        <Button layoutX="621.0" layoutY="685.0" onAction="#onSave" text="Save" />
        <Button layoutX="673.0" layoutY="685.0" onAction="#onCancel" text="Cancel" />
    </children>
</AnchorPane>
