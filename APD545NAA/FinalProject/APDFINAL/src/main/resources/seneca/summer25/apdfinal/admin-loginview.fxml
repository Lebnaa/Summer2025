<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="seneca.summer25.apdfinal.Controller.AdminLoginController"
      alignment="CENTER" spacing="25"
      style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);"
      prefWidth="400" prefHeight="350">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Admin Login" style="-fx-text-fill: #1a3c5e; -fx-font-weight: bold;">
        <font>
            <Font name="System Bold" size="24.0"/>
        </font>
    </Label>

    <GridPane hgap="15" vgap="20" alignment="CENTER">
        <Label text="Username:" style="-fx-text-fill: #2d6da0; -fx-font-weight: bold;"
               GridPane.rowIndex="0" GridPane.columnIndex="0">
            <font>
                <Font size="14.0"/>
            </font>
        </Label>
        <TextField fx:id="usernameField" prefHeight="35"
                   style="-fx-background-radius: 5; -fx-border-color: #2d6da0; -fx-border-radius: 5; -fx-border-width: 1;"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Password:" style="-fx-text-fill: #2d6da0; -fx-font-weight: bold;"
               GridPane.rowIndex="1" GridPane.columnIndex="0">
            <font>
                <Font size="14.0"/>
            </font>
        </Label>
        <PasswordField fx:id="passwordField" prefHeight="35"
                       style="-fx-background-radius: 5; -fx-border-color: #2d6da0; -fx-border-radius: 5; -fx-border-width: 1;"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="Login" fx:id="loginButton" onAction="#handleLogin"
            prefHeight="45" prefWidth="180"
            style="-fx-background-color: #e0c387; -fx-text-fill: #1a3c5e; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);">
        <font>
            <Font size="14.0"/>
        </font>
    </Button>

</VBox>