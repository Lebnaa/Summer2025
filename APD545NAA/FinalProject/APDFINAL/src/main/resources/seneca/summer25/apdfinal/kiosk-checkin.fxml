<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="500" prefWidth="600" style="-fx-background-color: linear-gradient(to bottom, #1a3c5e, #2d6da0);"
           xmlns="http://javafx.com/javafx/8.0.171"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="seneca.summer25.apdfinal.Controller.KioskCheckInController">

    <VBox alignment="CENTER" spacing="20"
          style="-fx-background-color: rgba(255, 255, 255, 0.85); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);">
        <padding>
            <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
        </padding>

        <Label text="Guest Check-In Confirmation"
               style="-fx-text-fill: #1a3c5e; -fx-font-weight: bold;">
            <font>
                <Font name="System Bold" size="24.0"/>
            </font>
        </Label>

        <VBox spacing="20" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">

            <TitledPane text="Booking Details" expanded="true" prefWidth="500"
                        style="-fx-text-fill: #1a3c5e; -fx-font-weight: bold;">
                <VBox spacing="15">
                    <padding>
                        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
                    </padding>

                    <HBox spacing="10">
                        <Label text="Guest Name:" style="-fx-font-weight: bold; -fx-text-fill: #2d6da0;"/>
                        <Label fx:id="guestNameLabel" text="[Guest Name]" style="-fx-text-fill: #444444;"/>
                    </HBox>

                    <HBox spacing="10">
                        <Label text="Room Type:" style="-fx-font-weight: bold; -fx-text-fill: #2d6da0;"/>
                        <Label fx:id="roomTypeLabel" text="[Room Type]" style="-fx-text-fill: #444444;"/>
                    </HBox>

                    <HBox spacing="10">
                        <Label text="Check-In Date:" style="-fx-font-weight: bold; -fx-text-fill: #2d6da0;"/>
                        <Label fx:id="checkInDateLabel" text="[Check-In Date]" style="-fx-text-fill: #444444;"/>
                    </HBox>

                    <HBox spacing="10">
                        <Label text="Check-Out Date:" style="-fx-font-weight: bold; -fx-text-fill: #2d6da0;"/>
                        <Label fx:id="checkOutDateLabel" text="[Check-Out Date]" style="-fx-text-fill: #444444;"/>
                    </HBox>

                    <HBox spacing="10">
                        <Label text="Number of Guests:" style="-fx-font-weight: bold; -fx-text-fill: #2d6da0;"/>
                        <Label fx:id="guestCountLabel" text="[Number of Guests]" style="-fx-text-fill: #444444;"/>
                    </HBox>
                </VBox>
            </TitledPane>

            <TitledPane text="Verification" expanded="true" prefWidth="500"
                        style="-fx-text-fill: #1a3c5e; -fx-font-weight: bold;">
                <VBox spacing="15">
                    <padding>
                        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
                    </padding>

                    <Label text="Please confirm your identity before proceeding with check-in."
                           style="-fx-text-fill: #444444;"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Phone Number:" style="-fx-font-weight: bold; -fx-text-fill: #2d6da0;"/>
                        <TextField fx:id="phoneVerificationField" promptText="Enter your phone number"
                                   prefWidth="250"
                                   style="-fx-background-radius: 5; -fx-border-color: #2d6da0; -fx-border-radius: 5;"/>
                    </HBox>
                </VBox>
            </TitledPane>

        </VBox>

        <HBox spacing="20" alignment="CENTER">
            <Button text="Back" fx:id="backButton" onAction="#handleBack"
                    prefHeight="45" prefWidth="120"
                    style="-fx-background-color: #2d6da0; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);">
                <font>
                    <Font size="14.0"/>
                </font>
            </Button>
            <Button text="Confirm Check-In" fx:id="confirmCheckInButton" onAction="#handleConfirmCheckIn"
                    prefHeight="45" prefWidth="200"
                    style="-fx-background-color: #1a3c5e; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);">
                <font>
                    <Font size="14.0"/>
                </font>
            </Button>
        </HBox>
    </VBox>
</StackPane>