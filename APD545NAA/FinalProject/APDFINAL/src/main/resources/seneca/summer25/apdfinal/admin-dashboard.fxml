<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20"
      style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="seneca.summer25.apdfinal.Controller.AdminDashboardController">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="Admin Dashboard" style="-fx-text-fill: #1a3c5e; -fx-font-weight: bold;">
        <font>
            <Font name="System Bold" size="24.0"/>
        </font>
    </Label>

    <Button fx:id="newReservationButton" onAction="#handleNewReservation" prefHeight="45" prefWidth="250"
            style="-fx-background-color: #1a3c5e; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);"
            text="New Reservation">
        <font>
            <Font size="14.0"/>
        </font>
    </Button>

    <Button fx:id="searchGuestButton" onAction="#handleSearchGuest" prefHeight="45" prefWidth="250"
            style="-fx-background-color: #1a3c5e; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);"
            text="Search Guest">
        <font>
            <Font size="14.0"/>
        </font>
    </Button>

    <Button fx:id="logoutButton" onAction="#handleLogout" prefHeight="45" prefWidth="250"
            style="-fx-background-color: #e0c387; -fx-text-fill: #1a3c5e; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);"
            text="Logout">
        <font>
            <Font size="14.0"/>
        </font>
    </Button>

</VBox>
