<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="500" prefWidth="600" style="-fx-background-color: linear-gradient(to bottom, #1a3c5e, #2d6da0);"
           xmlns="http://javafx.com/javafx/23.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="seneca.summer25.apdfinal.Controller.KioskWelcomeController">

    <VBox alignment="CENTER" spacing="25"
          style="-fx-background-color: rgba(255, 255, 255, 0.85); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);">

        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
        </padding>

        <Label style="-fx-text-fill: #1a3c5e; -fx-font-weight: bold;" text="Welcome to Hotel ABC">
            <font>
                <Font name="System Bold" size="28.0"/>
            </font>
        </Label>

        <Label style="-fx-text-fill: #444444;" text="Please choose an option below:">
            <font>
                <Font size="16.0"/>
            </font>
        </Label>

        <Region prefHeight="10"/>

        <Button fx:id="startBookingButton" onAction="#handleStartBooking" prefHeight="45" prefWidth="280"
                style="-fx-background-color: #1a3c5e; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);"
                text="Start Booking">
            <font>
                <Font size="14.0"/>
            </font>
        </Button>

        <Button fx:id="adminLoginButton" onAction="#handleAdminLogin" prefHeight="45" prefWidth="280"
                style="-fx-background-color: #e0c387; -fx-text-fill: #1a3c5e; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);"
                text="Admin Login">
            <font>
                <Font size="14.0"/>
            </font>
        </Button>

    </VBox>
</StackPane>
