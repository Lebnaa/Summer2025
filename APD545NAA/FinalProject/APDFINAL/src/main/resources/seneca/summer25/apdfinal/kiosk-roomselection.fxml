<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="seneca.summer25.apdfinal.Controller.KioskRoomSelectionController"
           prefWidth="600"
           prefHeight="650"
           style="-fx-background-color: linear-gradient(to bottom, #1a3c5e, #2d6da0);">

    <VBox alignment="CENTER" spacing="20"
          style="-fx-background-color: rgba(255, 255, 255, 0.85); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);">

        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <Label text="Select Room Type"
               style="-fx-text-fill: #1a3c5e; -fx-font-weight: bold;">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <Label text="Please choose from our available room options"
               style="-fx-text-fill: #444444;">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <ListView fx:id="roomListView"
                  prefHeight="200" prefWidth="450"
                  style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d0d0d0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 1);">
            <VBox.margin>
                <Insets top="10" bottom="10"/>
            </VBox.margin>
        </ListView>

        <VBox fx:id="suggestionBox"
              spacing="10"
              alignment="CENTER"
              visible="false"
              prefWidth="420"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 10, 0.5, 0, 4);">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Room Suggestion"
                   style="-fx-text-fill: #1a3c5e; -fx-font-size: 18px; -fx-font-weight: bold;" />

            <Label fx:id="suggestionMessage"
                   wrapText="true"
                   text="For 4 guests, we recommend 2 Deluxe Rooms."
                   style="-fx-text-fill: #333333; -fx-font-size: 14px;" />

            <HBox spacing="20" alignment="CENTER">
                <Button text="Continue" fx:id="btnContinue"
                        style="-fx-background-color: #1a3c5e; -fx-text-fill: white; -fx-background-radius: 5;" />
                <Button text="Choose Another" fx:id="btnChooseAnother"
                        style="-fx-background-color: #eeeeee; -fx-text-fill: #1a3c5e; -fx-background-radius: 5;" />
            </HBox>
        </VBox>

        <Region prefHeight="10" />

        <HBox spacing="15" alignment="CENTER">
            <Button text="View Rules"
                    fx:id="rulesButton"
                    onAction="#handleViewRules"
                    prefWidth="140" prefHeight="40"
                    style="-fx-background-color: #e0c387; -fx-text-fill: #1a3c5e; -fx-background-radius: 5; -fx-font-weight: bold;" />

            <Button text="Back"
                    onAction="#handleBack"
                    prefWidth="120" prefHeight="40"
                    style="-fx-background-color: #d0d0d0; -fx-text-fill: #444444; -fx-background-radius: 5; -fx-font-weight: bold;" />

            <Button text="Next"
                    fx:id="nextButton"
                    onAction="#handleNext"
                    prefWidth="120" prefHeight="40"
                    style="-fx-background-color: #1a3c5e; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;" />
        </HBox>
    </VBox>
</StackPane>
