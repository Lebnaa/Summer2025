<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.StackPane?>

<StackPane prefHeight="500" prefWidth="600" style="-fx-background-color: linear-gradient(to bottom, #1a3c5e, #2d6da0);"
           xmlns="http://javafx.com/javafx/8.0.171"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="seneca.summer25.apdfinal.Controller.AdminFeedbackController">

    <VBox alignment="CENTER" spacing="20"
          style="-fx-background-color: rgba(255, 255, 255, 0.85); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);">

        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <Label text="We Value Your Feedback" style="-fx-text-fill: #1a3c5e; -fx-font-weight: bold;">
            <font>
                <Font name="System Bold" size="26.0"/>
            </font>
        </Label>

        <Label text="Rate Your Stay:" style="-fx-text-fill: #2d6da0; -fx-font-weight: bold;">
            <font>
                <Font size="16.0"/>
            </font>
        </Label>

        <HBox alignment="CENTER" spacing="15">
            <Label text="1" style="-fx-text-fill: #444444;"/>
            <Slider fx:id="ratingSlider" min="1" max="5" value="3" showTickLabels="true" showTickMarks="true"
                    prefWidth="300" style="-fx-control-inner-background: #e6e6e6;"/>
            <Label text="5" style="-fx-text-fill: #444444;"/>
        </HBox>

        <Label text="Comments:" style="-fx-text-fill: #2d6da0; -fx-font-weight: bold;">
            <font>
                <Font size="16.0"/>
            </font>
        </Label>

        <TextArea fx:id="commentsArea" prefWidth="400" prefHeight="120"
                  style="-fx-background-radius: 5; -fx-border-color: #2d6da0; -fx-border-radius: 5; -fx-border-width: 1; -fx-focus-color: #1a3c5e;"
                  promptText="Please share your experience with us..."/>

        <HBox spacing="20" alignment="CENTER">
            <Button text="Submit" fx:id="submitButton" onAction="#handleSubmit"
                    prefHeight="45" prefWidth="150"
                    style="-fx-background-color: #1a3c5e; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);">
                <font>
                    <Font size="14.0"/>
                </font>
            </Button>

            <Button text="Skip" fx:id="skipButton" onAction="#handleSkip"
                    prefHeight="45" prefWidth="150"
                    style="-fx-background-color: #2d6da0; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);">
                <font>
                    <Font size="14.0"/>
                </font>
            </Button>
        </HBox>
    </VBox>
</StackPane>