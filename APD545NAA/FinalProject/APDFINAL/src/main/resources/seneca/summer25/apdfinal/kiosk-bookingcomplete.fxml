<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.StackPane?>

<StackPane prefHeight="400" prefWidth="500" style="-fx-background-color: linear-gradient(to bottom, #1a3c5e, #2d6da0);"
           xmlns="http://javafx.com/javafx/8.0.171"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="seneca.summer25.apdfinal.Controller.KioskBookingCompleteController">

    <VBox alignment="CENTER" spacing="25"
          style="-fx-background-color: rgba(255, 255, 255, 0.85); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);">

        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <Label text="Booking Successful!" style="-fx-text-fill: #1a3c5e; -fx-font-weight: bold;">
            <font>
                <Font name="System Bold" size="28.0"/>
            </font>
        </Label>

        <Label text="Please proceed to the front desk for billing." style="-fx-text-fill: #444444;">
            <font>
                <Font size="16.0"/>
            </font>
        </Label>

        <Button text="Finish" fx:id="finishButton" onAction="#handleFinish"
                prefHeight="45" prefWidth="200"
                style="-fx-background-color: #1a3c5e; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);">
            <font>
                <Font size="14.0"/>
            </font>
        </Button>
    </VBox>
</StackPane>