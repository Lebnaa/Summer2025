<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="seneca.summer25.apdfinal.Controller.KioskBookingConfirmationController"
           prefWidth="600"
           prefHeight="500"
           style="-fx-background-color: linear-gradient(to bottom, #1a3c5e, #2d6da0);">

    <VBox alignment="CENTER" spacing="20"
          style="-fx-background-color: rgba(255, 255, 255, 0.85); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);">

        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <Label text="Booking Confirmation"
               style="-fx-text-fill: #1a3c5e; -fx-font-weight: bold;">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <Label text="Please review your booking details below"
               style="-fx-text-fill: #444444;">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <TextArea fx:id="bookingSummaryArea"
                  prefWidth="450" prefHeight="250"
                  editable="false"
                  wrapText="true"
                  style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d0d0d0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 1); -fx-font-family: 'System'; -fx-font-size: 14px;">
            <VBox.margin>
                <Insets top="10" bottom="15"/>
            </VBox.margin>
        </TextArea>

        <Region prefHeight="10" />

        <HBox spacing="15" alignment="CENTER">
            <Button text="Back"
                    fx:id="backButton"
                    onAction="#handleBack"
                    prefWidth="120" prefHeight="40"
                    style="-fx-background-color: #d0d0d0; -fx-text-fill: #444444; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);">
                <font>
                    <Font size="14.0" />
                </font>
            </Button>

            <Button text="Confirm Booking"
                    fx:id="confirmButton"
                    onAction="#handleConfirm"
                    prefWidth="180" prefHeight="40"
                    style="-fx-background-color: #339933; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);">
                <font>
                    <Font size="14.0" />
                </font>
            </Button>
        </HBox>
    </VBox>
</StackPane>