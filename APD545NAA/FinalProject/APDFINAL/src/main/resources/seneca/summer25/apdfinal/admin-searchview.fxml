<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="seneca.summer25.apdfinal.Controller.AdminSearchGuestController"
      alignment="CENTER" spacing="20"
      style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Search Guest" style="-fx-text-fill: #1a3c5e; -fx-font-weight: bold;">
        <font>
            <Font name="System Bold" size="24.0"/>
        </font>
    </Label>

    <HBox spacing="15" alignment="CENTER">
        <TextField fx:id="searchField" promptText="Enter Name or Phone Number" prefWidth="300" prefHeight="35"
                   style="-fx-background-radius: 5; -fx-border-color: #2d6da0; -fx-border-radius: 5; -fx-border-width: 1;"/>
        <Button text="Search" fx:id="searchButton" onAction="#handleSearch" prefHeight="35" prefWidth="100"
                style="-fx-background-color: #1a3c5e; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);">
            <font>
                <Font size="14.0"/>
            </font>
        </Button>
    </HBox>

    <TableView fx:id="guestTableView" prefWidth="500" prefHeight="250"
               style="-fx-background-radius: 5; -fx-border-color: #2d6da0; -fx-border-radius: 5; -fx-border-width: 1;">
        <columns>
            <TableColumn fx:id="colGuestName" text="Guest Name" prefWidth="180"/>
            <TableColumn fx:id="colPhoneNumber" text="Phone Number" prefWidth="180"/>
            <TableColumn fx:id="colReservationStatus" text="Status" prefWidth="120"/>
        </columns>
    </TableView>

    <HBox spacing="20" alignment="CENTER">
        <Button text="View Details" fx:id="viewDetailsButton" onAction="#handleViewDetails"
                prefHeight="40" prefWidth="180"
                style="-fx-background-color: #2d6da0; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);">
            <font>
                <Font size="14.0"/>
            </font>
        </Button>
        <Button text="Cancel Reservation" fx:id="cancelReservationButton" onAction="#handleCancelReservation"
                prefHeight="40" prefWidth="180"
                style="-fx-background-color: #e0c387; -fx-text-fill: #1a3c5e; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);">
            <font>
                <Font size="14.0"/>
            </font>
        </Button>
    </HBox>

    <Button text="Back to Dashboard"
            onAction="#handleBack"
            prefHeight="40" prefWidth="200"
            style="-fx-background-color: #d0d0d0; -fx-text-fill: #444444; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);">
        <font>
            <Font size="14.0"/>
        </font>
    </Button>

</VBox>