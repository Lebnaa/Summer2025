<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="seneca.summer25.apdfinal.Controller.KioskGuestInfoFormController"
           prefWidth="600"
           prefHeight="500"
           style="-fx-background-color: linear-gradient(to bottom, #1a3c5e, #2d6da0);">

    <VBox alignment="CENTER" spacing="20"
          style="-fx-background-color: rgba(255, 255, 255, 0.85); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);">

        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <Label text="Enter Guest Information"
               style="-fx-text-fill: #1a3c5e; -fx-font-weight: bold;">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <Label text="Please provide your contact information"
               style="-fx-text-fill: #444444;">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <GridPane hgap="15" vgap="20" alignment="CENTER">
            <padding>
                <Insets top="20" right="0" bottom="20" left="0"/>
            </padding>

            <Label text="Full Name:"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"
                   style="-fx-text-fill: #1a3c5e; -fx-font-weight: bold;">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>
            <TextField fx:id="nameField"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"
                       prefHeight="35"
                       style="-fx-background-radius: 5; -fx-border-color: #d0d0d0; -fx-border-radius: 5; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 1);" />

            <Label text="Phone Number:"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"
                   style="-fx-text-fill: #1a3c5e; -fx-font-weight: bold;">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>
            <TextField fx:id="phoneField"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"
                       prefHeight="35"
                       style="-fx-background-radius: 5; -fx-border-color: #d0d0d0; -fx-border-radius: 5; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 1);" />

            <Label text="Guest Count:"
                   GridPane.rowIndex="2" GridPane.columnIndex="0"
                   style="-fx-text-fill: #1a3c5e; -fx-font-weight: bold;">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>
            <Spinner fx:id="guestCountSpinner"
                     GridPane.rowIndex="2" GridPane.columnIndex="1"
                     prefHeight="35"
                     style="-fx-background-radius: 5; -fx-border-color: #d0d0d0; -fx-border-radius: 5; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 1);" />

            <columnConstraints>
                <ColumnConstraints minWidth="150" />
                <ColumnConstraints minWidth="250" />
            </columnConstraints>
        </GridPane>

        <Region prefHeight="10" />

        <HBox alignment="CENTER" spacing="15">
            <Button fx:id="backButton"
                    text="Back"
                    onAction="#handleBack"
                    prefWidth="120" prefHeight="40"
                    style="-fx-background-color: #d0d0d0; -fx-text-fill: #444444; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);" />

            <Button text="Next"
                    fx:id="nextButton"
                    onAction="#handleNext"
                    prefWidth="120" prefHeight="40"
                    style="-fx-background-color: #1a3c5e; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);" />
        </HBox>
    </VBox>
</StackPane>
